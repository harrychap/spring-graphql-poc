type Query {
    transactions: [Transaction!]!
    transaction(id: ID!): Transaction
    transactionsByAccountId(accountId: ID!): [Transaction!]!
}

type Transaction @key(fields: "id") {
    id: ID!
    accountId: ID!
    amount: Float!
    description: String!
    date: String!
}

type Account @key(fields: "id") @extends {
    id: ID! @external
    transactions: [Transaction!]!
}
