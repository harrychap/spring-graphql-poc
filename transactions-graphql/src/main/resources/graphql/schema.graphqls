type Query {
    transactions: [Transaction!]!
    transaction(id: ID!): Transaction
    transactionsByAccountId(accountId: ID!): [Transaction!]!
}

type Transaction @key(fields: "id") {
    id: ID!
    accountId: ID!
    cardId: ID
    card: Card
    amount: Float!
    description: String!
    date: String!
}

type Card @key(fields: "id") {
    id: ID!
}

type Account @key(fields: "id") {
    id: ID!
    transactions: [Transaction!]!
}
