extend schema
  @link(url: "https://specs.apollo.dev/federation/v2.10", import: ["@key", "@external", "@extends"])
  @link(url: "https://specs.apollo.dev/connect/v0.2", import: ["@connect", "@source"])
  @source(name: "cards", http: { baseURL: "http://localhost:8083" })

type Query {
  cards: [Card!]!
    @connect(
      source: "cards"
      http: { GET: "/api/cards" }
      selection: "id accountId lastFour type expiry status"
    )
  card(id: ID!): Card
    @connect(
      source: "cards"
      http: { GET: "/api/cards/{$args.id}" }
      selection: "id accountId lastFour type expiry status"
      entity: true
    )
  cardsByAccountId(accountId: ID!): [Card!]!
    @connect(
      source: "cards"
      http: { GET: "/api/cards/account/{$args.accountId}" }
      selection: "id accountId lastFour type expiry status"
    )
}

type Card @key(fields: "id") {
  id: ID!
  accountId: ID!
  lastFour: String!
  type: String!
  expiry: String!
  status: String!
}

type Account @key(fields: "id") @extends {
  id: ID! @external
  cards: [Card!]!
    @connect(
      source: "cards"
      http: { GET: "/api/cards/account/{$this.id}" }
      selection: "id accountId lastFour type expiry status"
    )
}
