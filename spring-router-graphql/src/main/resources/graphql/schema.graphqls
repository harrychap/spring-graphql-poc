type Query {
    accounts: [Account!]!
    account(id: ID!): Account
    transactions: [Transaction!]!
    transaction(id: ID!): Transaction
    transactionsByAccountId(accountId: ID!): [Transaction!]!
    cards: [Card!]!
    card(id: ID!): Card
    cardsByAccountId(accountId: ID!): [Card!]!
}

type Account {
    id: ID!
    name: String!
    email: String!
    balance: Float!
    transactions: [Transaction!]!
    cards: [Card!]!
}

type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    description: String!
    date: String!
    account: Account
}

type Card {
    id: ID!
    accountId: ID!
    lastFour: String!
    type: String!
    expiry: String!
    status: String!
    account: Account
}
